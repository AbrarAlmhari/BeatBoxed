# Copy to .env.local and fill in your own values. Never commit real keys.

# Supabase (from your Supabase project settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (Client Credentials flow — from https://developer.spotify.com/dashboard)
# These are read by the spotify-token / spotify-search Edge Functions, NOT the
# frontend. Set them as Supabase secrets so they never reach a browser bundle:
#   supabase secrets set SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=...
# Keep them here too only if you run the functions locally with `supabase start`.
# Never prefix them with VITE_ — that would publish them in the client bundle.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gemini — generate from Google AI Studio (https://aistudio.google.com), NOT the consumer Gemini app
GEMINI_API_KEY=

# lrclib.net requires no API key
